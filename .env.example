# ==========================================
# PUBLIC FRONTEND CONFIGURATION 
# ==========================================
# These variables will be bundled into your React/Vite app.
# It is completely safe for these to be public.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ==========================================
# SECURITY WARNING: DO NOT ADD RAZORPAY KEYS
# ==========================================
# NEVER put your Razorpay Key ID or Secret here!
# Razorpay secrets (RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET) 
# must ONLY be stored inside your Supabase Edge Functions Secrets.
# 
# To add your Razorpay keys securely, run this command in your terminal:
# supabase secrets set RAZORPAY_KEY_ID="rzp_test_..." RAZORPAY_KEY_SECRET="..."
